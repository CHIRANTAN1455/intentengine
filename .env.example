APP_ENV=development

# Streamlit Community Cloud: paste the same KEY=value names into App settings → Secrets
# (they are read via st.secrets, not os.environ, unless you also export them locally.)

# OpenRouter
OPENROUTER_API_KEY=replace_with_openrouter_key
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_HTTP_REFERER=https://your-domain.example
OPENROUTER_APP_TITLE=IntentEngine
OPENROUTER_TIMEOUT_SECONDS=25
# Completion budget for normal (non-corpus) chat — keeps free-tier OpenRouter requests affordable.
OPENROUTER_MAX_TOKENS=512

# Direct LLM APIs (optional). Comma order: e.g. openai,anthropic,openrouter (default: openrouter only).
# LLM_PROVIDER_ORDER=openai,anthropic,openrouter
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=512
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages
ANTHROPIC_API_VERSION=2023-06-01
ANTHROPIC_MAX_TOKENS=4096

# Intent corpus (LLM fallback): stronger models + room for large JSON (optional overrides)
LLM_CORPUS_TIMEOUT_SECONDS=180
OPENAI_CORPUS_MODEL=gpt-4o
OPENAI_CORPUS_MAX_TOKENS=16384
ANTHROPIC_CORPUS_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_CORPUS_MAX_TOKENS=16384
OPENROUTER_CORPUS_MODEL=
OPENROUTER_CORPUS_MAX_TOKENS=16384

# NocoDB
# Create a table with columns: session_id (SingleLineText), step (Number), payload_json (LongText)
NOCODB_BASE_URL=https://app.nocodb.com
NOCODB_API_TOKEN=replace_with_nocodb_token
NOCODB_PIPELINE_TABLE_ID=replace_with_table_id

# When 1/true, upsert the full pipeline snapshot to NocoDB after intent refresh and after enrichment (silent on errors).
# AUTO_SAVE_PIPELINE_TO_NOCODB=1

# Optional events table with columns: event_type (SingleLineText), payload_json (LongText)
NOCODB_EVENTS_TABLE_ID=

# If your NocoDB column names differ, map them here:
NOCODB_FIELD_SESSION_ID=session_id
NOCODB_FIELD_STEP=step
NOCODB_FIELD_PAYLOAD_JSON=payload_json
NOCODB_FIELD_EVENT_TYPE=event_type
NOCODB_FIELD_EVENT_PAYLOAD_JSON=payload_json
