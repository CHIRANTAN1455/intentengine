APP_ENV=development

# Streamlit Community Cloud: paste these KEY=value lines into App settings → Secrets
# (they are read via st.secrets, not os.environ, unless you also export them locally.)

# --- LLM providers ---------------------------------------------------------
# Two providers, both direct. Default order: Anthropic Claude first, OpenAI second.
# Override with e.g. LLM_PROVIDER_ORDER=openai,anthropic to flip the priority.
LLM_PROVIDER_ORDER=anthropic,openai

# Anthropic Claude (direct API)
ANTHROPIC_API_KEY=replace_with_anthropic_key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages
ANTHROPIC_API_VERSION=2023-06-01
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_CORPUS_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_CORPUS_MAX_TOKENS=16384

# OpenAI (direct API)
OPENAI_API_KEY=replace_with_openai_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
OPENAI_MAX_TOKENS=1024
OPENAI_CORPUS_MODEL=gpt-4o
OPENAI_CORPUS_MAX_TOKENS=16384

# Per-call timeouts (seconds).
LLM_TIMEOUT_SECONDS=30
LLM_CORPUS_TIMEOUT_SECONDS=180

# --- Production-safety flags ----------------------------------------------
# Contact data: AI generation of contacts is DISABLED in code. Always.
# Enrichment will surface verified contacts from Apollo (when APOLLO_API_KEY is set)
# or leave person fields blank. There is no env flag to re-enable LLM fabrication.
#
# Synthetic intent corpus (LLM-generated job postings) is OFF by default.
# Only enable for local sandbox runs; do NOT enable in production.
ALLOW_SYNTHETIC_INTENT_CORPUS=0

# --- Performance flags ----------------------------------------------------
# Email sequences default to deterministic templates (no per-lead LLM call).
# Set to 1 to opt in to LLM augmentation per lead.
EMAIL_LLM_AUGMENT=0

# Role-strategy suggestions default to deterministic templates. Set to 1 to
# opt in to LLM augmentation per role.
ROLE_SUGGESTIONS_LLM=0

# Reply classifier defaults to using the LLM (good quality, low per-reply
# cost). Set to 0 to use the rule-based classifier only.
REPLY_CLASSIFIER_LLM=1

# --- HubSpot CRM (optional) -----------------------------------------------
# Private app access token: Settings → Integrations → Private Apps → your app.
# Scopes: crm.objects.contacts (read + write), crm.objects.notes (write), and
# crm.schemas.contacts.read if you use custom properties later.
# Sync creates/updates contacts by email and adds a timeline note (job URLs,
# intent score, posting excerpt). Outbound email still runs in HubSpot using
# your connected personal/team inbox under HubSpot email settings.
# HUBSPOT_ACCESS_TOKEN=
# (alias) HUBSPOT_PRIVATE_APP_TOKEN=

# --- Apollo contact enrichment (optional) ---------------------------------
# Master API key from Apollo.io → Settings → API. Enables people search +
# people/match so Enrichment fills Name / Email / Title / LinkedIn / phone
# (when returned). Uses Apollo credits per your plan.
# APOLLO_API_KEY=
# Optional: HTTPS webhook URL required by Apollo when requesting async phone reveal.
# APOLLO_PHONE_WEBHOOK_URL=
# Max companies to call Apollo for per enrichment run (rate limits / cost cap).
# ENRICHMENT_MAX_COMPANIES=50
# Pause in seconds between Apollo HTTP calls.
# ENRICHMENT_REQUEST_DELAY_SECONDS=0.35

# --- NocoDB ---------------------------------------------------------------
# Create a table with columns: session_id (SingleLineText), step (Number), payload_json (LongText)
NOCODB_BASE_URL=https://app.nocodb.com
NOCODB_API_TOKEN=replace_with_nocodb_token
NOCODB_PIPELINE_TABLE_ID=replace_with_table_id

# When 1/true, upsert the full pipeline snapshot to NocoDB after intent refresh
# and after enrichment (silent on errors).
# AUTO_SAVE_PIPELINE_TO_NOCODB=1

# Optional events table with columns: event_type (SingleLineText), payload_json (LongText)
NOCODB_EVENTS_TABLE_ID=

# If your NocoDB column names differ, map them here:
NOCODB_FIELD_SESSION_ID=session_id
NOCODB_FIELD_STEP=step
NOCODB_FIELD_PAYLOAD_JSON=payload_json
NOCODB_FIELD_EVENT_TYPE=event_type
NOCODB_FIELD_EVENT_PAYLOAD_JSON=payload_json

# LongText columns are often capped at 100000 characters. Snapshots are auto-compacted
# (job listing snippets removed first, then row caps) to stay under this budget.
# NOCODB_PAYLOAD_JSON_MAX_CHARS=95000
